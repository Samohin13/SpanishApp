<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud + device-transfer бэкап включает только указанные preferences.
  БД (spanish_app.db) не попадает — Android резервирует только то, что
  явно перечислено в <include>. Прогресс синхронизируется через Firestore.
  Аутентификационные токены Firebase хранятся в Google Play Services
  и в Auto-Backup не попадают.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="voice_prefs.xml"/>
        <include domain="sharedpref" path="theme_prefs.xml"/>
        <include domain="sharedpref" path="user_settings.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="voice_prefs.xml"/>
        <include domain="sharedpref" path="theme_prefs.xml"/>
        <include domain="sharedpref" path="user_settings.xml"/>
    </device-transfer>
</data-extraction-rules>
