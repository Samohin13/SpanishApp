<?xml version="1.0" encoding="utf-8"?>
<!--
  SEC-5 (v1.25.76): cloud-backup и device-transfer ужесточены.

  Чувствительные DataStore prefs явно исключены из бэкапа и transfer'а:
   - subscription_prefs — PRO статус (источник правды = Firestore через SEC-1)
   - ai_chat_limit — счётчик AI запросов
   - auth_prefs — Firebase tokens (всё равно хранятся в Google Play Services
     и в Auto-Backup не попадают, но дублируем для defense-in-depth)

  Аутентификационные токены Firebase хранятся в Google Play Services и в
  Auto-Backup не попадают (Google security model).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/subscription_prefs.preferences_pb"/>
        <exclude domain="file" path="datastore/ai_chat_limit.preferences_pb"/>
        <exclude domain="file" path="datastore/auth_prefs.preferences_pb"/>
        <exclude domain="database" path="spanish_app.db"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/subscription_prefs.preferences_pb"/>
        <exclude domain="file" path="datastore/ai_chat_limit.preferences_pb"/>
        <exclude domain="file" path="datastore/auth_prefs.preferences_pb"/>
        <exclude domain="database" path="spanish_app.db"/>
    </device-transfer>
</data-extraction-rules>
