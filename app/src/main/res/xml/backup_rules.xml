<?xml version="1.0" encoding="utf-8"?>
<!--
  Бэкап включает только нужное: prefs приложения и БД с прогрессом.
  Аутентификационные токены Firebase хранятся в собственном хранилище
  Google Play Services и в сихронизацию Auto-Backup не попадают.
-->
<full-backup-content>
    <include domain="sharedpref" path="voice_prefs.xml"/>
    <include domain="sharedpref" path="theme_prefs.xml"/>
    <include domain="sharedpref" path="user_settings.xml"/>
    <include domain="database" path="spanish_app.db"/>
</full-backup-content>
