<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drawable references give us crisp vector rendering at every density,
         making the per-density mipmap PNGs (foreground/background) effectively
         unused. They're kept for older launchers that don't read adaptive-icon. -->
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
