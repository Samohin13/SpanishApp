<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Радио: фоновое воспроизведение через MediaSessionService -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Loudness normalization (LoudnessEnhancer audio effect) — выравнивает
         громкость между станциями. Normal permission, без runtime запроса. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!--
      CAMERA убрана: на текущий момент аватар-пикер использует
      ActivityResultContracts.PickVisualMedia (Photo Picker, без
      запроса разрешения). «Сделать фото» через камеру не реализовано.
      Объявленная-но-неиспользуемая CAMERA вынуждала Play Console
      требовать обязательное обоснование политикой конфиденциальности
      именно для CAMERA и пугала первых пользователей. Если в будущем
      добавим «снять фото для аватара» — вернём <uses-permission> сюда.
    -->

    <application
        android:name=".SpanishApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpanishApp"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SpanishApp.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            android:theme="@style/Theme.App.ImageCropper" />

        <!-- FileProvider для share-картинок прогресса (ui/share). Через него
             system share-chooser (WhatsApp/Telegram/…) получает read-доступ к
             temporary PNG в cacheDir/shares/. Authority = applicationId + ".fileprovider". -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Радио: MediaSessionService для фонового воспроизведения -->
        <service
            android:name="com.spanishapp.radio.player.RadioPlayerService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Виджет «Слово дня» -->
        <receiver
            android:name=".widget.WordOfDayWidgetReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET"
            android:label="Слово дня">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/word_of_day_widget_info" />
        </receiver>

        <!-- v1.14.0: Виджет «Поиск в словаре» -->
        <receiver
            android:name=".widget.DictionarySearchWidgetReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET"
            android:label="Поиск в словаре">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dictionary_search_widget_info" />
        </receiver>

        <!-- v1.14.0: Виджет «Цель дня» -->
        <receiver
            android:name=".widget.MissionTrackerWidgetReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET"
            android:label="Цель дня">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mission_tracker_widget_info" />
        </receiver>

        <!-- v1.14.0: Виджет «Streak 🔥» -->
        <receiver
            android:name=".widget.StreakFlameWidgetReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET"
            android:label="Streak дней подряд">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/streak_flame_widget_info" />
        </receiver>

        <!-- v1.14.0: Виджет «Репетитор» (AI Chat shortcut) -->
        <receiver
            android:name=".widget.AiChatWidgetReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET"
            android:label="Репетитор">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ai_chat_widget_info" />
        </receiver>

        <!-- v1.14.0: Виджет «Радио» -->
        <receiver
            android:name=".widget.RadioWidgetReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET"
            android:label="Радио España">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/radio_widget_info" />
        </receiver>

    </application>

</manifest>
