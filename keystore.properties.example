# ────────────────────────────────────────────────────────────
# Skopiruj v keystore.properties (БЕЗ суффикса .example) и
# заполни своими данными. Файл keystore.properties в .gitignore.
#
# Как создать release.keystore (Android Studio):
#   Build → Generate Signed App Bundle/APK → Create new...
# Или через CLI:
#   keytool -genkey -v -keystore release.keystore \
#           -keyalg RSA -keysize 2048 -validity 10000 \
#           -alias ESPEAK
# ────────────────────────────────────────────────────────────

storeFile=release.keystore
storePassword=ВАШ_ПАРОЛЬ_ОТ_KEYSTORE
keyAlias=ESPEAK
keyPassword=ВАШ_ПАРОЛЬ_ОТ_KEY
